---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScheduleDay from '../components/ScheduleDay.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const site = import.meta.env.SITE;
const calendarUrl = `${site}${base}calendar.ics`.replace(/([^:])\/\//g, '$1/');
const webcalUrl = calendarUrl.replace(/^https?:\/\//, 'webcal://');
const googleUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcalUrl)}`;

const schedule = await getCollection('schedule');
type ScheduleEntry = (typeof schedule)[number];
const sortedSchedule = [...schedule].sort((a: ScheduleEntry, b: ScheduleEntry) => a.data.day - b.data.day);
---

<BaseLayout
  title="Programme — 28th EMBL PhD Symposium 2026"
  description="Full programme for the 28th EMBL PhD Symposium: invited talks, workshops, and social events over three days."
>
  <!-- Page Hero -->
  <div class="relative bg-green-900 pt-32 pb-20 overflow-hidden">
    <img
      src={`${base}gear-all.svg`}
      alt=""
      aria-hidden="true"
      class="absolute -top-12 -right-24 w-120 gear-spin-slow pointer-events-none select-none"
      style="filter: invert(1) opacity(0.06);"
    />
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-10 bg-green-500"></div>
        <span class="label-tag text-green-400">3-Day Symposium</span>
      </div>
      <h1 class="font-display font-800 text-white text-5xl lg:text-7xl mb-4">Programme</h1>
      <p class="font-body text-white/60 text-lg max-w-2xl">
        Three focused days at the intersection of automation, AI, and high-throughput biology. From
        robotic workflows and large-scale screening to scalable data analysis and translational applications.
      </p>

      <!-- Day quick links -->
      <div class="flex flex-wrap gap-3 mt-8">
        {sortedSchedule.map((day: ScheduleEntry) => (
          <a
            href={`#day-${day.data.day}`}
            class="font-mono text-sm px-5 py-2.5 border border-white/20 text-white/70 hover:text-white hover:border-green-400 transition-all"
            style={`hover:border-color: ${day.data.color};`}
          >
            Day {day.data.day}: {day.data.title}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Legend -->
  <div class="bg-parchment border-b border-warm">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-4">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span class="font-mono text-xs tracking-[0.15em] text-ink uppercase font-600">Session types:</span>
        {[
          ['workshop', 'Workshop'       ],
          ['poster',   'Poster Session' ],
          ['keynote',  'Keynote Lecture'],
          ['social',   'Social Event'   ],
          ['talk',     'Invited Talk'   ],
          ['panel',    'Panel'          ],
          ['ceremony', 'Ceremony'       ],
        ].map(([type, label]) => (
          <div class="flex items-center gap-1.5">
            <span class:list={['session-badge', `badge-${type}`]}>{type}</span>
            <span class="font-body text-xs text-muted">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Provisional notice -->
  <div class="border-b" style="background: var(--color-magenta-tint); border-color: var(--color-magenta-border-md);">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-3 flex items-center gap-3">
      <svg class="w-4 h-4 shrink-0" style="color: var(--color-red-500);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
      </svg>
      <p class="font-body text-sm" style="color: var(--color-red-100);">
        <strong class="font-semibold">Provisional programme.</strong> Sessions, speakers, and timings are subject to change. The final programme will be confirmed closer to the event.
      </p>
    </div>
  </div>

  <!-- Add to Calendar -->
  <div class="bg-warm border-b border-green-800">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-3 flex flex-wrap items-center gap-3">
      <span class="label-tag text-muted">Add to calendar:</span>
      <a
        href={webcalUrl}
        class="flex items-center gap-1.5 font-mono text-[0.65rem] px-3 py-1.5 border border-green-600 text-green-400 hover:bg-green-800 hover:text-green-100 hover:border-green-500 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Apple / Outlook
      </a>
      <a
        href={googleUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 font-mono text-[0.65rem] px-3 py-1.5 border border-green-600 text-green-400 hover:bg-green-800 hover:text-green-100 hover:border-green-500 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Google Calendar
      </a>
      <a
        href={calendarUrl}
        download="phd-symposium-2026.ics"
        class="flex items-center gap-1.5 font-mono text-[0.65rem] px-3 py-1.5 border border-green-600 text-green-400 hover:bg-green-800 hover:text-green-100 hover:border-green-500 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download .ics
      </a>
    </div>
  </div>

  <!-- Schedule content -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-24">
    <div class="space-y-4">
      {sortedSchedule.map((day: ScheduleEntry, i: number) => (
        <div id={`day-${day.data.day}`}>
          <ScheduleDay
            day={day.data.day}
            date={day.data.date}
            title={day.data.title}
            color={day.data.color}
            sessions={day.data.sessions}
            defaultOpen={i === 0}
          />
        </div>
      ))}
    </div>

    <!-- Registration callout -->
    <div id="registration" class="mt-20 bg-green-900 relative overflow-hidden">
      <img
        src={`${base}gear3.svg`}
        alt=""
        aria-hidden="true"
        class="absolute -bottom-10 -right-10 w-56 gear-spin-slow pointer-events-none"
        style="filter: invert(1) opacity(0.07);"
      />
      <div class="relative p-10 lg:p-16">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-4">
            <div class="h-px w-8 bg-red-500"></div>
            <span class="label-tag text-red-400">Registration</span>
          </div>
          <h2 class="font-display font-800 text-white text-3xl lg:text-4xl mb-4">
            Join us in Heidelberg
          </h2>
          <p class="font-body text-white/70 mb-8 text-lg leading-relaxed">
            Registration is now open. Select the option that applies to you.
          </p>
          <div class="space-y-5">
            <div>
              <p class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-white/40 mb-2">On-site</p>
              <div class="flex flex-wrap gap-3">
                <a href="https://embl.ungerboeck.com/PROD/emc00/register.aspx?aat=3532786b714233776141585163793455734f654f74696e367936556f57664e4d516e744135536d7372546b3d" target="_blank" rel="noopener noreferrer" class="font-display font-700 text-sm px-6 py-3 bg-red-600 text-white hover:bg-red-700 transition-colors">Standard</a>
                <a href="https://embl.ungerboeck.com/PROD/emc00/register.aspx?aat=716d4d6a4e676f6932323267614d42736b796b6c6f536b454d503669763449717575504642757a6b48726f3d" target="_blank" rel="noopener noreferrer" class="font-display font-700 text-sm px-6 py-3 border border-white/30 text-white hover:bg-white/10 transition-colors">EMBL-affiliated</a>
              </div>
            </div>
            <div>
              <p class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-white/40 mb-2">Virtual</p>
              <div class="flex flex-wrap gap-3">
                <a href="https://embl.ungerboeck.com/PROD/emc00/register.aspx?aat=43657545326f35693631452b686830594d6b512b2f75534a46724653322b316e796a58665a3548656773343d" target="_blank" rel="noopener noreferrer" class="font-display font-700 text-sm px-6 py-3 bg-red-600 text-white hover:bg-red-700 transition-colors">Standard</a>
                <a href="https://embl.ungerboeck.com/PROD/emc00/register.aspx?aat=6b43594953694d6b613539313869736b454449474f67444e714c306e5a59724668516e35504b66336d4f383d" target="_blank" rel="noopener noreferrer" class="font-display font-700 text-sm px-6 py-3 border border-white/30 text-white hover:bg-white/10 transition-colors">EMBL-affiliated</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Days are folded <details>; open the one a link points at (the quick
  // links above, or the home page's day cards → /program#day-N).
  function openDay(hash: string, only = false) {
    const day = hash ? document.getElementById(hash.slice(1))?.querySelector('details') : null;
    if (!day) return;
    if (only) document.querySelectorAll<HTMLDetailsElement>('details[data-date]').forEach(d => (d.open = false));
    day.open = true;
  }
  // Arriving from a day link: show just that day
  openDay(location.hash, true);
  window.addEventListener('hashchange', () => openDay(location.hash));
  // Re-clicking the link for the current hash fires no hashchange
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#day-"]').forEach(a =>
    a.addEventListener('click', () => openDay(a.hash))
  );

  // During the symposium, show today's programme instead of Day 1
  const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' }); // YYYY-MM-DD
  const todays = document.querySelector<HTMLDetailsElement>(`details[data-date="${today}"]`);
  if (todays && !location.hash) {
    document.querySelectorAll<HTMLDetailsElement>('details[data-date]').forEach(d => (d.open = d === todays));
  }
</script>


