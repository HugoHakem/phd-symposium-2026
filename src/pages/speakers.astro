---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import { getCollection, render } from 'astro:content';
const base = import.meta.env.BASE_URL;

const speakers = await getCollection('speakers');
type Speaker = (typeof speakers)[number];

const sortedSpeakers = [...speakers].sort((a: Speaker, b: Speaker) => {
  return a.data.day - b.data.day;
});

// Pre-render all bios
const rendered = await Promise.all(
  sortedSpeakers.map(async (s: Speaker) => {
    const { Content } = await render(s);
    return { id: s.id, Content };
  })
);
const bioMap = Object.fromEntries(rendered.map(r => [r.id, r.Content]));
---

<BaseLayout
  title="Speakers — 28th EMBL PhD Symposium 2026"
  description="Meet the invited speakers of the 28th EMBL PhD Symposium: Shifting gears — automation, AI, and high-throughput methodologies."
>
  <!-- Page Hero -->
  <div class="relative bg-green-900 pt-32 pb-20 overflow-hidden">
    <img
      src={`${base}gear2.svg`}
      alt=""
      aria-hidden="true"
      class="absolute -bottom-16 -right-20 w-100 gear-spin-reverse pointer-events-none select-none"
      style="filter: invert(1) opacity(0.06);"
    />
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-10 bg-green-500"></div>
        <span class="label-tag text-green-400">Invited Scientists</span>
      </div>
      <h1 class="font-display font-800 text-white text-5xl lg:text-7xl mb-4">Speakers</h1>
      <p class="font-body text-white/60 text-lg max-w-2xl">
        Twelve leading scientists from institutions across the world — each advancing discovery
        through automation, high-throughput methodologies, and AI-driven analysis.
      </p>

      <!-- Stats row -->
      <div class="flex flex-wrap gap-8 mt-10 pt-8 border-t border-white/10">
        {[
          { value: '12', label: 'Invited Speakers' },
          { value: '7',  label: 'Student Talks'    },
          { value: '2',   label: 'Panels'           },
        ].map(({ value, label }) => (
          <div>
            <p class="font-display font-800 text-green-400 text-3xl">{value}</p>
            <p class="font-mono text-[0.6rem] tracking-[0.15em] uppercase text-white/40">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- All speakers, one grid -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {sortedSpeakers.map((speaker: Speaker) => (
        <SpeakerCard
          slug={speaker.id}
          name={speaker.data.name}
          role={speaker.data.role}
          institution={speaker.data.institution}
          country={speaker.data.country}
          topic={speaker.data.topic}
          day={speaker.data.day}
          sessionType={speaker.data.sessionType}
          image={speaker.data.image}
          keynote={speaker.data.keynote}
        />
      ))}
    </div>

    <!-- Bio panels, one per speaker -->
    {sortedSpeakers.map((speaker: Speaker) => {
      const Bio = bioMap[speaker.id];
      return (
        <div id={speaker.id} class="bio-panel">
          <div class="bio-panel-inner">
            <!-- Speaker header inside bio -->
            <div class="bio-header">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class:list={['session-badge', 'badge-talk']}>
                    {speaker.data.sessionType}
                  </span>
                  {speaker.data.keynote && (
                    <span class="session-badge badge-keynote">Keynote</span>
                  )}
                  <span class="font-mono text-[0.6rem] text-muted uppercase tracking-widest">Day {speaker.data.day}</span>
                </div>
                <h3 class="font-display font-800 text-ink text-2xl lg:text-3xl mb-1">{speaker.data.name}</h3>
                <p class="font-body text-muted mb-0.5">{speaker.data.role}</p>
                <p class="font-display font-600 text-green-700">{speaker.data.institution} · {speaker.data.country}</p>
              </div>
            </div>
            <!-- Talk info -->
            <div class="bio-talk">
              <p class="label-tag text-red-600 mb-2">Talk</p>
              <p class="font-display font-700 text-ink text-lg leading-tight">{speaker.data.topic}</p>
            </div>
            <!-- Bio text -->
            <div class="bio-content prose-bio">
              <Bio />
            </div>
            <!-- External links -->
            <div class="bio-links">
              {speaker.data.website && (
                <a
                  href={speaker.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bio-link"
                >
                  🔗 Personal / Lab Website
                </a>
              )}
              {speaker.data.twitter && (
                <a
                  href={`https://twitter.com/${speaker.data.twitter}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bio-link"
                >
                  𝕏 @{speaker.data.twitter}
                </a>
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  .bio-panel {
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    margin-bottom: 2rem;
    scroll-margin-top: 5rem;
  }
  .bio-panel-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .bio-header {
    padding: 2rem 2rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .bio-talk {
    padding: 1.5rem 2rem;
    background: var(--color-magenta-tint);
    border-bottom: 1px solid var(--color-magenta-border-sm);
    border-left: 3px solid var(--color-red-600);
  }
  .bio-content {
    padding: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .bio-links {
    padding: 1.25rem 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .bio-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-green-500);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-green-700);
    background: var(--color-green-900);
    transition: background 0.2s, border-color 0.2s;
  }
  .bio-link:hover {
    background: var(--color-green-800);
    border-color: var(--color-green-500);
  }

  /* Prose styles for bio content */
  .prose-bio :global(p) {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-bio :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose-bio :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .bio-header,
    .bio-talk,
    .bio-content,
    .bio-links {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }
</style>
