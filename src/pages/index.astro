---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import SponsorsSection from '../components/SponsorsSection.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;

const speakers = await getCollection('speakers');
const sponsors = await getCollection('sponsors');
const schedule = await getCollection('schedule');

type Speaker = (typeof speakers)[number];
type Schedule = (typeof schedule)[number];

const allSpeakers = [...speakers].sort((a: Speaker, b: Speaker) => a.data.day - b.data.day);

const scheduleByDay = [...schedule].sort((a: Schedule, b: Schedule) => a.data.day - b.data.day);
---

<BaseLayout
  title="28th EMBL PhD Symposium 2026 — Shifting gears: automation, AI, and high-throughput methodologies"
  description="The 28th EMBL PhD Symposium: Shifting gears: automation, AI, and high-throughput methodologies. December 2–4, 2026 at EMBL Heidelberg."
>
  <HeroSection />

  <!-- ── About / Theme Section ─────────────────────────────── -->
  <section class="py-24 lg:py-32 bg-parchment clip-diagonal-down">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Left: text -->
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-10 bg-red-600"></div>
            <span class="label-tag text-red-600">About the Symposium</span>
          </div>
          <h2 class="font-display font-800 text-ink text-4xl lg:text-5xl mb-6 leading-[1.05]">
            Biology at a <br />new scale
          </h2>
          <div class="font-body text-muted text-lg leading-relaxed space-y-4">
            <p>
              The 28th EMBL PhD Symposium explores how automation, high-throughput methodologies, and artificial
              intelligence are accelerating scientific discovery by enhancing speed, reliability, and reproducibility
              across biological disciplines.
            </p>
            <p>
              Over three focused days, we bring together researchers and engineers at the frontier of scalable
              science: from robotic wet-lab workflows and large-scale screening to AI-driven data analysis and
              translational biomedical applications.
            </p>
          </div>

          <!-- Key stats -->
          <div class="grid grid-cols-3 gap-6 mt-10 pt-8 border-t border-warm">
            {[
              { value: '12', label: 'Invited Speakers' },
              { value: '3', label: 'Focused Days'     },
              { value: '100+', label: 'Participants'  },
            ].map(({ value, label }) => (
              <div>
                <p class="font-display font-800 text-green-800 text-4xl mb-1">{value}</p>
                <p class="font-mono text-[0.65rem] tracking-[0.12em] uppercase text-muted">{label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: day cards -->
        <div class="space-y-4">
          {scheduleByDay.map((day) => (
            <a
              href={`${base}program#day-${day.data.day}`}
              class="day-preview-card group block"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <span
                    class="font-display font-800 text-3xl"
                    style={`color: ${day.data.color};`}
                  >
                    {String(day.data.day).padStart(2, '0')}
                  </span>
                  <div>
                    <p class="font-display font-700 text-ink text-lg group-hover:text-green-800 transition-colors">
                      {day.data.title}
                    </p>
                  </div>
                </div>
                <svg class="w-5 h-5 text-muted group-hover:text-green-700 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Invited Speakers Section ──────────────────────────── -->
  <section class="py-24 lg:py-32 bg-green-900 clip-both-diagonal">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="h-px w-10 bg-green-500"></div>
            <span class="label-tag text-green-400">Invited Speakers</span>
          </div>
          <h2 class="font-display font-800 text-white text-4xl lg:text-5xl">
            Invited<br />Speakers
          </h2>
        </div>
        <a
          href={`${base}speakers`}
          class="self-start md:self-auto font-display font-700 text-sm px-6 py-3 border border-green-500/50 text-green-400 hover:bg-green-500/10 transition-colors"
        >
          All Speakers →
        </a>
      </div>

      <!-- All speakers — scrollable band -->
      <div class="relative">
        <div class="absolute right-0 top-0 bottom-0 w-24 pointer-events-none z-10"
             style="background: linear-gradient(to left, var(--color-green-900), transparent);"></div>
        <div class="overflow-x-auto invited-scroll-track pt-4 -mt-4 pb-2 -mb-2">
          <div class="flex gap-5 pb-4">
            {allSpeakers.map((speaker: Speaker) => (
              <div class="shrink-0 w-72">
                <SpeakerCard
                  slug={speaker.id}
                  name={speaker.data.name}
                  role={speaker.data.role}
                  institution={speaker.data.institution}
                  country={speaker.data.country}
                  topic={speaker.data.topic}
                  day={speaker.data.day}
                  sessionType={speaker.data.sessionType}
                  image={speaker.data.image}
                  keynote={speaker.data.keynote}
                  embo={speaker.data.embo}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Key Dates Section ─────────────────────────────────── -->
  <section class="py-24 lg:py-32 bg-parchment">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Key dates -->
        <div>
          <div class="flex items-center gap-3 mb-8">
            <div class="h-px w-10 bg-red-600"></div>
            <span class="label-tag text-red-600">Important Dates</span>
          </div>
          <h2 class="font-display font-800 text-ink text-4xl mb-10">Mark your<br />calendar</h2>
          <div class="space-y-0">
            {[
              { date: 'August 10, 2026',    label: 'Early-Bird Registration Deadline'   },
              { date: 'September 9, 2026',  label: 'Abstract Submission Deadline'       },
              { date: 'September 16, 2026', label: 'Abstract Selection Notification'    },
              { date: 'October 21, 2026',   label: 'On-Site Registration Deadline'      },
              { date: 'November 25, 2026',  label: 'Virtual Registration Deadline'      },
              { date: 'December 2, 2026',   label: 'Symposium Begins', highlight: true  },
              { date: 'December 4, 2026',   label: 'Symposium Ends'                     },
            ].map(({ date, label, highlight }, i) => (
              <div class:list={['date-row', highlight ? 'date-row-highlight' : '']} data-date={date}>
                <div class="date-marker">
                  <span class="font-mono font-600 text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <div class="flex-1">
                  <p class:list={['font-display font-700 text-base', highlight ? 'text-red-600' : 'text-ink']}>
                    {label}
                  </p>
                  <p class="font-mono text-xs text-muted">{date}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Venue teaser -->
        <div class="flex flex-col justify-center">
          <div
            class="relative overflow-hidden bg-green-800 p-10 lg:p-12"
            style="background: linear-gradient(135deg, var(--color-green-800) 0%, var(--color-green-900) 100%);"
          >
            <!-- Gear decoration -->
            <img
              src={`${base}gear3.svg`}
              alt=""
              aria-hidden="true"
              class="absolute -bottom-8 -right-8 w-48 gear-spin-slow"
              style="filter: invert(1) opacity(0.07);"
            />
            <div class="relative">
              <div class="flex items-center gap-3 mb-6">
                <div class="h-px w-8 bg-green-400"></div>
                <span class="label-tag text-green-400">Venue</span>
              </div>
              <h3 class="font-display font-800 text-white text-3xl mb-4 leading-tight">
                EMBL Heidelberg
              </h3>
              <p class="font-body text-white/70 mb-6 leading-relaxed">
                Set in the wooded hills above Heidelberg, EMBL's main campus is home to
                world-class research facilities and a vibrant international community.
                The ATC Auditorium seats 500 and provides state-of-the-art conference facilities.
              </p>
              <div class="space-y-2 mb-8">
                {[
                  'Meyerhofstraße 1, 69117 Heidelberg',
                  '15 min from Heidelberg city centre',
                  'On-campus accommodation available',
                ].map(info => (
                  <p class="font-mono text-xs text-white/50 flex items-center gap-2">
                    <span class="text-green-400">→</span> {info}
                  </p>
                ))}
              </div>
              <a
                href={`${base}about#venue`}
                class="inline-flex items-center gap-2 font-display font-700 text-sm text-green-400 border border-green-400/30 px-6 py-3 hover:bg-green-400/10 transition-colors"
              >
                Travel Info
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Sponsors Section ──────────────────────────────────── -->
  <SponsorsSection sponsors={sponsors} />
</BaseLayout>

<style>
  .day-preview-card {
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    padding: 1.5rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .day-preview-card:hover {
    border-color: var(--color-green-500);
    box-shadow: 0 4px 16px var(--color-cyan-glow-sm);
  }

  .invited-scroll-track {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.08) transparent;
  }
  .invited-scroll-track::-webkit-scrollbar {
    height: 2px;
  }
  .invited-scroll-track::-webkit-scrollbar-track {
    background: transparent;
  }
  .invited-scroll-track::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 1px;
  }

  .date-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .date-row:last-child { border-bottom: none; }
  .date-row-highlight {
    background: var(--color-magenta-tint);
    margin: 0 -1.5rem;
    padding: 0.875rem 1.5rem;
    border-color: var(--color-magenta-border-sm);
  }
  .date-marker {
    width: 2rem;
    text-align: center;
    flex-shrink: 0;
  }
  .date-row.is-past {
    opacity: 0.4;
  }
  .date-row.is-past .font-display {
    text-decoration: line-through;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-date]').forEach(row => {
    if (new Date(row.dataset.date!) < new Date()) {
      row.classList.add('is-past');
    }
  });
</script>
