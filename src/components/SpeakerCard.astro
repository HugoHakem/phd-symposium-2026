---
interface Props {
  slug: string;
  name: string;
  role: string;
  institution: string;
  country: string;
  topic: string;
  sessionType: 'talk' | 'workshop-lead' | 'panel';
  day: number;
  image?: string;
  compact?: boolean;
  keynote?: boolean;
  embo?: boolean;
}

const { slug, name, role, institution, topic, day, image, compact = false, keynote = false, embo = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const dayLabels: Record<number, string> = {
  1: 'Day 1 — Dec 2',
  2: 'Day 2 — Dec 3',
  3: 'Day 3 — Dec 4',
};

const initials = name.split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase();
---

<article class:list={['speaker-card group', compact ? 'compact' : '']}>
  <a href={`${base}speakers#${slug}`} class="block h-full">
    <!-- Avatar area -->
    <div class="avatar-wrap">
      {keynote && (
        <span class="keynote-badge session-badge badge-keynote">
          {embo ? (
            <><img src={`${base}sponsors/embo-logo-badge.svg`} alt="EMBO" class="embo-badge-logo" /> Keynote Lecture</>
          ) : 'Keynote Lecture'}
        </span>
      )}
      {image ? (
        <img src={`${base}${image}`} alt={name} class="avatar-img" loading="lazy" />
      ) : (
        <div class="avatar-placeholder">
          <span>{initials}</span>
        </div>
      )}
    </div>

    <!-- Info -->
    <div class="card-body">
      <div class="mb-1">
        <span class="font-mono text-[0.6rem] tracking-[0.15em] text-muted uppercase">
          {dayLabels[day]}
        </span>
      </div>

      <h3 class="font-display font-700 text-ink text-lg lg:text-xl leading-tight mb-1 group-hover:text-green-800 transition-colors">
        {name}
      </h3>

      <p class="font-body text-sm text-muted mb-3 leading-snug">
        {role} <br />
        <span class="text-green-700 font-500">{institution}</span>
      </p>

      {!compact && (
        <p class="font-body text-sm text-ink/70 leading-snug line-clamp-2">
          {topic}
        </p>
      )}
    </div>
  </a>
</article>

<style>
  .speaker-card {
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .speaker-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px var(--color-cyan-glow-md), 0 0 0 1px var(--color-green-500);
    border-color: var(--color-green-500);
  }

  .avatar-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--color-warm);
  }
  .keynote-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 1;
  }
  .embo-badge-logo {
    height: 1.15rem;
    width: auto;
    display: inline-block;
    vertical-align: middle;
    margin: -0.1rem 0.1em -0.1rem 0;
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .speaker-card:hover .avatar-img {
    transform: scale(1.04);
  }
  .avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-green-800) 0%, var(--color-green-700) 100%);
  }
  .avatar-placeholder span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-cyan-glow-lg);
    letter-spacing: -0.03em;
  }

  .card-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .compact .card-body {
    padding: 1rem 1.25rem 1.25rem;
  }
  .compact .avatar-wrap {
    aspect-ratio: 3/2;
  }
</style>
