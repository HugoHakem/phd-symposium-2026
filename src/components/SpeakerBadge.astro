---
// One recognition badge (e.g. EMBO Young Investigator), styled like the
// session badges but outlined rather than filled, so it reads as a separate
// marker and doesn't add a hue to the validated session-type palette.
import { SPEAKER_BADGES, type SpeakerBadgeId } from '../lib/speakerBadges';

interface Props {
  id: SpeakerBadgeId;
}

const { id } = Astro.props;
const badge = SPEAKER_BADGES[id];
const base = import.meta.env.BASE_URL;
---

<span class="session-badge speaker-badge">
  <img src={`${base}${badge.logo}`} alt={badge.alt} class="speaker-badge-logo" />
  {badge.label}
</span>

<style>
  .speaker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    background: rgba(7, 20, 20, 0.85);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px rgba(221, 240, 240, 0.35);
    white-space: nowrap;
  }
  .speaker-badge-logo {
    height: 1.15rem;
    width: auto;
    margin: -0.1rem 0;
  }
</style>
