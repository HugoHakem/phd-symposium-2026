---
import InlineLogo from './InlineLogo.astro';

// Sponsor ids whose logo is a dark colourway not designed for a dark card —
// these are inlined and selectively recoloured via CSS (see the
// .recolour-* rules below) instead of using the plain <img> path, so only
// the dark parts turn white and any other brand colour is kept.
const SELECTIVE_RECOLOUR_IDS = new Set(['evident', 'sanofi', '10x-genomics', 'netapp', 'leica', 'thermofisher', 'illumina', 'adelphi-genetics-forum']);

interface Sponsor {
  id: string;
  data: {
    name: string;
    tier: 'sponsor' | 'prize' | 'support' | 'grant' | 'cpp';
    subTier?: 'founder_partner' | 'corporate_partner' | 'associate_partner';
    order?: number;
    website?: string;
    description?: string;
    logo?: string;
    logoTreatment?: 'normal' | 'invert';
  };
}

interface Props {
  sponsors: Sponsor[];
}

const { sponsors } = Astro.props;
const base = import.meta.env.BASE_URL;

// Explicit `order` first (ascending), then by name for entries without one.
const byOrder = (a: Sponsor, b: Sponsor) =>
  (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || a.data.name.localeCompare(b.data.name);
const inTier = (tier: Sponsor['data']['tier']) => sponsors.filter(s => s.data.tier === tier).sort(byOrder);

// Logo-card tiers, in display order: logo with an optional short caption.
const logoTiers = [
  { label: 'Sponsors', items: inTier('sponsor') },
  { label: 'Prizes',   items: inTier('prize')   },
  { label: 'Support',  items: inTier('support') },
].filter(t => t.items.length > 0);
const grants       = inTier('grant');
const cppSponsors  = sponsors.filter(s => s.data.tier === 'cpp');

const cppSubTiers = [
  { key: 'founder_partner',   label: 'Founder Partners'    },
  { key: 'corporate_partner', label: 'Corporate Partners'  },
  { key: 'associate_partner', label: 'Associate Partners'  },
] as const;

const cppGrouped = Object.fromEntries(
  cppSubTiers.map(({ key }) => [key, cppSponsors.filter(s => s.data.subTier === key)])
);
---

<section class="py-24 lg:py-32 bg-cream">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section header -->
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-px w-10 bg-red-600"></div>
        <span class="label-tag text-red-600">Acknowledgements</span>
      </div>
      <h2 class="font-display font-800 text-ink text-4xl lg:text-5xl mb-4">
        Our Sponsors
      </h2>
      <p class="font-body text-muted text-lg max-w-2xl">
        The 28th EMBL PhD Symposium is made possible by the generous support of our institutional and industry partners.
      </p>
    </div>

    <!-- Sponsors, Prizes, Support -->
    {logoTiers.map(({ label, items }) => (
      <div class="sponsor-tier-group">
        <div class="tier-header">
          <h3 class="font-mono text-xs tracking-[0.2em] uppercase font-700 text-green-400">{label}</h3>
          <div class="tier-line"></div>
        </div>
        <div class="sponsors-grid grid-cpp">
          {items.map((sponsor) => (
            <a
              href={sponsor.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="sponsor-card sponsor-cpp sponsor-supporter"
              title={sponsor.data.name}
            >
              {sponsor.data.logo && SELECTIVE_RECOLOUR_IDS.has(sponsor.id) ? (
                <InlineLogo file={sponsor.data.logo} class={`recolour-${sponsor.id}`} />
              ) : sponsor.data.logo ? (
                <img
                  src={`${base}${sponsor.data.logo}`}
                  alt={sponsor.data.name}
                  class:list={['sponsor-logo', sponsor.data.logoTreatment === 'invert' && 'sponsor-logo--invert']}
                 
                  loading="lazy"
                />
              ) : (
                <div class="sponsor-name font-display font-700">{sponsor.data.name}</div>
              )}
              {sponsor.data.description && <p class="supporter-caption font-mono">{sponsor.data.description}</p>}
            </a>
          ))}
        </div>
      </div>
    ))}

    <!-- Grants -->
    {grants.length > 0 && (
      <div class="sponsor-tier-group">
        <div class="tier-header">
          <h3 class="font-mono text-xs tracking-[0.2em] uppercase font-700 text-green-400">Grants</h3>
          <div class="tier-line"></div>
        </div>
        <div class="sponsors-grid grid-grant">
          {grants.map((sponsor) => (
            <a
              href={sponsor.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="sponsor-card sponsor-grant"
              title={sponsor.data.name}
            >
              <div class="sponsor-name font-display font-700">{sponsor.data.name}</div>
              <p class="sponsor-desc font-body text-sm text-muted">{sponsor.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- CPP Sponsors -->
    {cppSponsors.length > 0 && (
      <div class="sponsor-tier-group">
        <div class="tier-header">
          <h3 class="font-mono text-xs tracking-[0.2em] uppercase font-700 text-green-400">EMBL Corporate Partnership Programme</h3>
          <div class="tier-line"></div>
        </div>
        {cppSubTiers.map(({ key, label }) => cppGrouped[key]?.length > 0 && (
          <div class="cpp-subtier-group">
            <p class="font-mono text-xs tracking-[0.15em] uppercase font-600 text-green-400 mb-3">{label}</p>
            <div class="sponsors-grid grid-cpp">
              {cppGrouped[key].map((sponsor) => (
                <a
                  href={sponsor.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsor-card sponsor-cpp"
                  title={sponsor.data.name}
                >
                  {sponsor.data.logo && SELECTIVE_RECOLOUR_IDS.has(sponsor.id) ? (
                    <InlineLogo file={sponsor.data.logo} class={`recolour-${sponsor.id}`} />
                  ) : sponsor.data.logo ? (
                    <img
                      src={`${base}${sponsor.data.logo}`}
                      alt={sponsor.data.name}
                      class:list={['sponsor-logo', sponsor.data.logoTreatment === 'invert' && 'sponsor-logo--invert']}
                 
                      loading="lazy"
                    />
                  ) : (
                    <div class="sponsor-name font-display font-700">{sponsor.data.name}</div>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Become a sponsor CTA -->
    <div class="mt-16 pt-16 border-t border-warm">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <h3 class="font-display font-700 text-xl text-ink mb-1">Interested in sponsoring?</h3>
          <p class="font-body text-muted">Contact us to discuss partnership opportunities for the symposium.</p>
        </div>
        <a
          href="mailto:phdsymposium2026.partners@embl.de"
          class="font-display font-700 text-sm px-8 py-4 bg-green-800 text-white hover:bg-green-900 transition-colors whitespace-nowrap"
        >
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .sponsor-tier-group {
    margin-bottom: 3rem;
  }

  .cpp-subtier-group {
    margin-bottom: 2rem;
  }

  .tier-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .tier-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .sponsors-grid {
    display: grid;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  .grid-grant   { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .grid-cpp {
    /* Flexbox, not grid: a partial last row (e.g. one leftover logo) then
       just centers itself with blank space either side, instead of CSS
       Grid reserving empty cells that show the container's own background
       as dark "missing tile" gaps. No shared background/border here — each
       card carries its own border instead, so leftover centering space is
       genuinely blank rather than a solid block in the gap colour. */
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    background: transparent;
    border: none;
  }
  .grid-cpp .sponsor-cpp {
    /* flex-grow: 0 — cards stay a fixed, uniform size regardless of how
       many share their row. With growth enabled, a card left alone on the
       last row (e.g. a single leftover logo) would stretch wider than its
       neighbours above; centering the row already handles the leftover
       space, so no growth is needed. */
    flex: 0 1 220px;
    border: 1px solid var(--color-border);
  }

  .sponsor-card {
    background: var(--color-cream);
    padding: 1.5rem 2rem;
    transition: background 0.2s, transform 0.2s;
    display: block;
  }
  .sponsor-card:hover {
    background: var(--color-warm);
    transform: translateY(-2px);
  }
  .sponsor-cpp {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    padding: 1.25rem 1.5rem;
  }

  .grid-cpp .sponsor-supporter {
    /* Wider than CPP cards: the Frontiers lockup is very wide (~5.5:1) and
       would shrink to an illegible strip in a 220px card. */
    flex-basis: 280px;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sponsor-supporter .sponsor-logo {
    max-width: 90%;
  }
  .supporter-caption {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }




  .sponsor-grant .sponsor-name { font-size: 1rem;    color: var(--color-ink); }
  .sponsor-cpp   .sponsor-name { font-size: 0.9rem;  color: var(--color-muted); }

  .sponsor-logo {
    max-height: 3.5rem;
    width: auto;
    max-width: 80%;
    object-fit: contain;
    display: block;
  }
  .sponsor-logo--invert {
    /* Non-destructive fix for logos whose dark colourway is illegible on
       our dark card background — flips them to a light silhouette via CSS
       filter, without touching the source SVG. Used sparingly, only where
       the logo would otherwise disappear (see logoTreatment in sponsor
       front matter). */
    filter: brightness(0) invert(1);
  }

  .sponsor-desc {
    margin-top: 0.5rem;
    line-height: 1.5;
  }
  .sponsor-cpp .sponsor-desc {
    display: none;
  }

  @media (max-width: 640px) {
    .grid-grant, .grid-cpp {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /*
   * Selective, post-hoc logo recolouring — for the sponsor ids listed in
   * SELECTIVE_RECOLOUR_IDS above. The SVG is inlined (see InlineLogo.astro)
   * so individual shapes can be targeted; the source files on disk are
   * never edited. Each logo's dark colourway (illegible on our dark card)
   * defaults to white, and a per-logo exception restores whichever brand
   * colours should stay as-is. SVG presentation attributes (fill="…") have
   * the lowest CSS priority, so the blanket rule below overrides them
   * freely; an inline style="fill:…" (ThermoFisher's red wordmark) still
   * wins over both, so no exception is needed there.
   */
  .recolour-evident :is(path, rect, polygon, circle, ellipse, polyline),
  .recolour-sanofi :is(path, rect, polygon, circle, ellipse, polyline),
  .recolour-10x-genomics :is(path, rect, polygon, circle, ellipse, polyline),
  .recolour-netapp :is(path, rect, polygon, circle, ellipse, polyline),
  .recolour-leica :is(path, rect, polygon, circle, ellipse, polyline),
  .recolour-thermofisher :is(path, rect, polygon, circle, ellipse, polyline) {
    fill: #ffffff;
  }
  /* Illumina isn't in the blanket rule above — every one of its shapes is
     inline-styled (see the !important override below), so the blanket
     rule would never apply to it anyway. */

  /* Evident — keep its blue checkmark accent */
  .recolour-evident [fill='#005CB9'] { fill: #005CB9; }

  /* Sanofi — keep its purple accent dots */
  .recolour-sanofi .st0 { fill: #7A00E6; }

  /* 10x Genomics — keep the four accent colours in the "X" mark */
  .recolour-10x-genomics [fill="#14b3e6"] { fill: #14b3e6; }
  .recolour-10x-genomics [fill="#59c134"] { fill: #59c134; }
  .recolour-10x-genomics [fill="#e6c00c"] { fill: #e6c00c; }
  .recolour-10x-genomics [fill="#ed1559"] { fill: #ed1559; }

  /* NetApp — keep its blue icon mark */
  .recolour-netapp [fill="#0067C5"] { fill: #0067C5; }

  /* Leica — keep the red "Leica" script; only "MICROSYSTEMS" turns white */
  .recolour-leica [fill="#ec1c28"] { fill: #ec1c28; }

  /* Adelphi Genetics Forum — not in the blanket white rule above. Its navy
     wordmark (#204093, ~2:1 on our cards) is lifted to a tint taken from the
     knot's own navy-to-white gradient, so it stays in the logo's colour
     family and sits at the same brightness as the other blue logos (CDD
     Vault, Merck). The gradient-filled knot keeps its brand colours. */
  .recolour-adelphi-genetics-forum [fill="#204093"] { fill: #555da8; }

  /* Illumina — its grey wordmark is set via an inline style="fill:…"
     attribute, which (unlike a bare fill="…" presentation attribute) beats
     any external stylesheet rule regardless of specificity, so it needs
     !important here to turn white. The orange "i" dot is inline-styled the
     same way, so it's already naturally protected — no exception needed. */
  .recolour-illumina [style*="616161"] { fill: #ffffff !important; }
</style>
