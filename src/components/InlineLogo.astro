---
// Inlines an SVG sponsor logo so its individual shapes can be selectively
// recoloured via CSS (see the `recolour-*` rules in SponsorsSection.astro).
// The source file on disk is never modified — this only affects how the
// browser renders a copy of its markup.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  /** Path relative to static/, e.g. "sponsors/embl-corporate-partners/evident.svg" */
  file: string;
  class?: string;
  /** Box size, e.g. from logoBoxStyle() — the SVG fills it, keeping its aspect. */
  style?: string;
}

const { file, class: className, style } = Astro.props;
const filePath = path.join(process.cwd(), 'static', file);
const svg = fs.readFileSync(filePath, 'utf-8');
---
<div class:list={['inline-logo', className]} style={style} set:html={svg} />

<style is:global>
  .inline-logo {
    /* A definite box is needed — the source SVGs carry no width/height of
       their own (only a viewBox), so pure max-* sizing would collapse to 0.
       The caller normally sets width/height via `style`; this is a fallback. */
    display: block;
    height: 3.5rem;
    max-width: 100%;
  }
  .inline-logo svg {
    height: 100%;
    width: 100%;
    display: block;
  }
</style>
