---
interface Session {
  time: string;
  title: string;
  type: string;
  keynote?: boolean;
  embo?: boolean;
  speaker?: string;
  speakerSlug?: string;
  abstract?: string;
  location?: string;
}

interface Props {
  day: number;
  date: string;
  title: string;
  color: string;
  sessions: Session[];
  defaultOpen?: boolean;
}

const { day, date, title, color, sessions, defaultOpen = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const formattedDate = new Date(date + 'T12:00:00').toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const badgeClasses: Record<string, string> = {
  talk:     'badge-talk',
  workshop: 'badge-workshop',
  break:    'badge-break',
  lunch:    'badge-lunch',
  social:   'badge-social',
  ceremony: 'badge-ceremony',
  panel:    'badge-panel',
  poster:   'badge-poster',
};

const isMainEvent = (type: string) => ['talk', 'panel', 'ceremony'].includes(type);

// Shown in the header so a folded day still says what's in it
const timeSpan = `${sessions[0]?.time} – ${sessions[sessions.length - 1]?.time}`;
const keynoteSpeakers = sessions.filter(s => s.keynote && s.speaker).map(s => s.speaker);
---

<details class="schedule-day" open={defaultOpen} data-date={date}>
  <!-- Day Header (click to fold/unfold the day) -->
  <summary
    class="day-header"
    style={`border-left: 4px solid ${color};`}
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-x-3 mb-1">
          <span
            class="font-mono text-[0.65rem] tracking-[0.15em] uppercase font-600 whitespace-nowrap"
            style={`color: ${color};`}
          >Day {day}</span>
          <span class="text-border font-mono text-xs max-sm:hidden">·</span>
          <span class="font-mono text-xs tracking-[0.15em] uppercase text-muted whitespace-nowrap">{formattedDate}</span>
        </div>
        <h2 class="font-display font-800 text-ink text-2xl lg:text-3xl">{title}</h2>
        <p class="font-mono text-[0.65rem] tracking-[0.12em] uppercase text-muted mt-2">
          {timeSpan} · {sessions.length} sessions
          {keynoteSpeakers.length > 0 && <> · Keynote{keynoteSpeakers.length > 1 && 's'}: {keynoteSpeakers.join(', ')}</>}
        </p>
      </div>
      <span class="day-toggle" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </span>
    </div>
  </summary>

  <!-- Sessions -->
  <div class="sessions-list">
    {sessions.map((session) => (
      <div
        class:list={[
          'session-row',
          isMainEvent(session.type) ? 'session-main' : 'session-utility',
        ]}
      >
        <!-- Time column -->
        <div class="session-time">
          <span class="font-mono text-sm font-600 text-ink/70">{session.time}</span>
        </div>

        <!-- Content column -->
        <div class="session-content">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class:list={['session-badge', badgeClasses[session.type] || 'badge-break']}>
              {session.type}
            </span>
            {session.keynote && (
              <span class="session-badge badge-keynote">
                {session.embo ? (
                  <><img src={`${base}sponsors/embo-logo-badge.svg`} alt="EMBO" class="embo-badge-logo" /> Keynote Lecture</>
                ) : 'Keynote Lecture'}
              </span>
            )}
          </div>

          <h3
            class:list={[
              'font-display font-700 leading-tight mb-2',
              isMainEvent(session.type) ? 'text-lg lg:text-xl text-ink' : 'text-base text-muted',
            ]}
          >
            {session.speakerSlug ? (
              <a href={`${base}speakers#${session.speakerSlug}`} class="hover:underline">
                {session.title}
                {session.speaker && ` – ${session.speaker}`}
              </a>
            ) : (
              session.title
            )}
          </h3>

          {session.location && (
            <p class="font-mono text-[0.6rem] tracking-[0.12em] text-muted/70 uppercase mt-2">
              📍 {session.location}
            </p>
          )}
        </div>
      </div>
    ))}
  </div>
</details>

<style>
  .schedule-day {
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    overflow: hidden;
  }

  .day-header {
    display: block;
    cursor: pointer;
    list-style: none;
    transition: background 0.15s ease;
    padding: 2rem 2rem 1.5rem;
    background: var(--color-warm);
    border-bottom: 1px solid var(--color-border);
    margin-left: -1px;
  }

  .day-header::-webkit-details-marker {
    display: none;
  }
  .day-header:hover {
    background: var(--color-border);
  }
  .day-header:focus-visible {
    outline: 2px solid var(--color-green-500);
    outline-offset: -2px;
  }
  /* Folded: no divider under the header, since nothing follows it */
  .schedule-day:not([open]) .day-header {
    border-bottom-color: transparent;
  }

  .day-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    align-self: center;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    transition: transform 0.2s ease, color 0.15s ease;
  }
  .day-header:hover .day-toggle {
    color: var(--color-ink);
  }
  .schedule-day[open] .day-toggle {
    transform: rotate(180deg);
  }

  /* Animate the fold where the browser supports it (Chrome 131+); others just toggle */
  @supports (interpolate-size: allow-keywords) {
    .schedule-day {
      interpolate-size: allow-keywords;
    }
    .schedule-day::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.3s ease, content-visibility 0.3s allow-discrete;
    }
    .schedule-day[open]::details-content {
      block-size: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .day-toggle,
    .schedule-day::details-content {
      transition: none;
    }
  }

  .sessions-list {
    divide-y: var(--color-border);
  }

  .session-row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.15s ease;
  }
  .session-row:last-child {
    border-bottom: none;
  }
  .session-row:hover {
    background: var(--color-warm);
  }

  .session-main {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .session-utility {
    opacity: 0.8;
  }
  .session-utility:hover {
    opacity: 1;
  }

  .session-time {
    padding-top: 0.25rem;
    text-align: right;
    flex-shrink: 0;
  }

  /*
   * Full EMBO logo (tight-cropped copy) used inline in place of the word
   * "EMBO" in the keynote badge. Height is tuned so the logo sits within the
   * badge without overflowing and its "EMBO" lettering reads at roughly the
   * badge font size; small negative block margins keep it off the line box.
   */
  .embo-badge-logo {
    height: 1.15rem;
    width: auto;
    display: inline-block;
    vertical-align: middle;
    margin: -0.1rem 0.1em -0.1rem 0;
  }

  @media (max-width: 640px) {
    .session-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1rem 1.25rem;
    }
    .session-time {
      text-align: left;
    }
    .day-header {
      padding: 1.5rem 1.25rem 1.25rem;
    }
  }
</style>
